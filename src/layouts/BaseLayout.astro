---
import '../styles/global.css';
import SectionRail from '../components/SectionRail.astro';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'Portafolio', description = 'Portafolio personal y proyectos seleccionados.' } = Astro.props;
const canonicalUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : Astro.url.toString();
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Ignacio Angelone',
  jobTitle: 'Desarrollador de Software · IA aplicada',
  url: canonicalUrl,
  image: new URL('/images/profile.jpeg', canonicalUrl).toString(),
  sameAs: ['https://www.linkedin.com/in/ignacioangelone/'],
  knowsAbout: ['Desarrollo de software a medida', 'Desarrollo para PYMES', 'Inteligencia artificial', 'Automatización de procesos', 'SaaS'],
};
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="author" content="Ignacio Angelone" />
    <meta name="creator" content="Ignacio Angelone" />
    <meta name="publisher" content="Ignacio Angelone" />
    <meta name="application-name" content="Ignacio Angelone · Portafolio" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content="Ignacio Angelone" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={new URL('/og-image.png', canonicalUrl).toString()} />
    <meta property="og:image:width" content="1536" />
    <meta property="og:image:height" content="1024" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    <link rel="icon" type="image/png" href="/logo.png?v=2" />
    <title>{title}</title>
  </head>
  <body class="bg-black text-slate-100 antialiased">
    <main><slot /></main>
    <SectionRail />
  </body>
</html>
