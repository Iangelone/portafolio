---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'Portafolio', description = 'Portafolio personal y proyectos seleccionados.' } = Astro.props;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>
  </head>
  <body class="bg-ink-950 text-slate-100 antialiased">
    <main><slot /></main>
  </body>
</html>
