---
interface Props {
  number: string;
  title: string;
  description: string;
  image: string;
}

const { number, title, description, image } = Astro.props;
const whatsappMessages: Record<string, string> = {
  '01': 'Hola Ignacio, vi tu portafolio y me gustaría conversar sobre sistemas de negocio para mi empresa.',
  '02': 'Hola Ignacio, vi tu portafolio y me gustaría conversar sobre soluciones de IA y automatización.',
  '03': 'Hola Ignacio, vi tu portafolio y me gustaría conversar sobre una oportunidad para sumarte a nuestro equipo.',
};
const whatsappUrl = `https://wa.me/5491122867368?text=${encodeURIComponent(whatsappMessages[number] ?? `Hola Ignacio, vi tu portafolio y me gustaría conversar sobre ${title}.`)}`;
---

<a data-service-card href={whatsappUrl} target="_blank" rel="noreferrer" aria-label={`Consultar por ${title}`} class="group relative isolate block overflow-hidden border-b border-ink-500 py-6 outline-none sm:py-8">
  <div aria-hidden="true" class="pointer-events-none absolute inset-y-0 right-0 z-0 w-1/2 opacity-0 transition-opacity duration-700 ease-out">
    <div class={`service-tetris-art service-tetris-art-${number}`}>
      <span></span><span></span><span></span><span></span><span></span><span></span>
      <span></span><span></span><span></span><span></span><span></span><span></span>
    </div>
    <div class="absolute inset-0" style="background: linear-gradient(90deg, #000000 0%, rgba(0,0,0,0.99) 22%, rgba(0,0,0,0.92) 42%, rgba(0,0,0,0.68) 64%, rgba(0,0,0,0.3) 82%, rgba(0,0,0,0) 100%);"></div>
  </div>
  <div class="relative z-10 grid min-h-24 grid-cols-[5rem_1fr] items-center gap-6 sm:grid-cols-[6rem_1fr] sm:gap-10">
    <span class="origin-left text-6xl font-semibold leading-none tracking-tighter text-accent-cream transition-transform duration-500 ease-out sm:text-8xl">{number}</span>
    <div class="service-copy max-w-xl transition-[opacity,transform] duration-500 ease-out sm:translate-x-3 sm:opacity-0">
      <h3 class="text-2xl font-semibold tracking-tight text-white sm:text-3xl">{title}</h3>
      <p class="mt-2 max-w-md text-sm leading-6 text-slate-300">{description}</p>
    </div>
  </div>
</a>

<script>
  const cards = [...document.querySelectorAll<HTMLElement>('[data-service-card]')];
  const section = document.querySelector<HTMLElement>('[data-service-section]');
  let timer = 0;
  let activeIndex = 0;

  const revealNextCard = () => {
    if (activeIndex >= cards.length) {
      stopAnimation();
      return;
    }
    cards[activeIndex].classList.add('is-revealed');
    activeIndex += 1;
  };

  const stopAnimation = () => {
    window.clearInterval(timer);
    timer = 0;
  };

  const startAnimation = () => {
    if (timer || activeIndex >= cards.length || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    revealNextCard();
    if (activeIndex < cards.length) timer = window.setInterval(revealNextCard, 2000);
  };

  if (section && cards.length) {
    const observer = new IntersectionObserver(([entry]) => {
      if (entry.isIntersecting) startAnimation();
      else stopAnimation();
    }, { threshold: 0.2 });
    observer.observe(section);
  }
</script>
