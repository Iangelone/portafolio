---
interface Props {
  title: string;
  description: string;
  tags: string[];
  image?: string;
}

const { title, description, tags, image } = Astro.props;
---

<article class="group rounded-2xl border border-ink-500 bg-ink-900 p-6 transition hover:-translate-y-1 hover:border-accent-cream/50 hover:bg-ink-800">
	{image && <img src={image} alt={`Captura de ${title}`} loading="lazy" class="mb-6 aspect-video w-full rounded-xl object-cover object-top" />}
  <div class="mb-10 flex items-start justify-between gap-4">
    <span class="text-sm text-accent-cream">Proyecto destacado</span>
    <span class="text-xl text-slate-500 transition group-hover:text-accent-cream" aria-hidden="true">↗</span>
  </div>
  <h3 class="text-2xl font-semibold tracking-tight">{title}</h3>
  <p class="mt-3 leading-7 text-slate-400">{description}</p>
  <div class="mt-6 flex flex-wrap gap-2">
    {tags.map((tag) => <span class="rounded-full bg-ink-700 px-3 py-1 text-xs text-slate-300">{tag}</span>)}
  </div>
</article>
