---
interface Props {
  title: string;
  description: string;
  tags: string[];
}

const { title, description, tags } = Astro.props;
---

<article class="group rounded-2xl border border-white/10 bg-white/[0.03] p-6 transition hover:-translate-y-1 hover:border-cyan-400/50 hover:bg-white/[0.06]">
  <div class="mb-10 flex items-start justify-between gap-4">
    <span class="text-sm text-cyan-400">Proyecto destacado</span>
    <span class="text-xl text-slate-500 transition group-hover:text-cyan-400" aria-hidden="true">↗</span>
  </div>
  <h3 class="text-2xl font-semibold tracking-tight">{title}</h3>
  <p class="mt-3 leading-7 text-slate-400">{description}</p>
  <div class="mt-6 flex flex-wrap gap-2">
    {tags.map((tag) => <span class="rounded-full bg-slate-800 px-3 py-1 text-xs text-slate-300">{tag}</span>)}
  </div>
</article>
