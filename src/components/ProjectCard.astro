---
interface Props {
  title: string;
  description: string;
  tags: string[];
  source: string;
  image?: string;
  reverse?: boolean;
  index?: number;
}

const { title, description, tags, source, image, reverse = false, index = 0 } = Astro.props;
const number = String(index + 1).padStart(2, '0');
---

<article
  class:list={[
    'group grid items-center gap-10 py-16 motion-safe:animate-[project-enter_900ms_cubic-bezier(0.22,1,0.36,1)_both] md:grid-cols-2 md:gap-16 lg:py-24',
    reverse && 'md:[&>div:first-child]:order-2 md:[&>div:last-child]:order-1',
  ]}
  style={`animation-delay: ${index * 100}ms`}
>
  <div>
    <div class="mb-8 flex items-center gap-4 text-sm text-accent-cream"><span>{number}</span><span class="h-px w-10 bg-accent-brown"></span><span>{source}</span></div>
    <h3 class="max-w-xl text-4xl font-semibold tracking-tight text-white sm:text-5xl">{title}</h3>
    <p class="mt-6 max-w-lg text-lg leading-8 text-slate-400">{description}</p>
    <div class="mt-8 flex flex-wrap gap-2">
      {tags.map((tag) => <span class="rounded-full border border-white/30 bg-accent-cream/90 px-3.5 py-1.5 text-xs font-medium text-accent-brown-dark shadow-sm shadow-black/10 backdrop-blur-sm">{tag}</span>)}
    </div>
  </div>

  <div class="relative">
    {image ? (
      <>
        <div aria-hidden="true" class="absolute -right-5 top-5 h-full w-full rounded-[1.75rem] bg-cover bg-center opacity-55 blur-md" style={`background-image: url('${image}')`}></div>
        <button type="button" class="project-preview relative z-10 block w-full cursor-pointer text-left" data-project-image={image} data-project-title={title} data-project-source={source} aria-label={`Ver imágenes de ${title}`}>
          <img src={image} alt={`Captura de ${title}`} loading="lazy" class="block h-auto w-full rounded-[1.75rem]" />
        </button>
      </>
    ) : (
      <div class="flex min-h-[280px] items-end bg-[radial-gradient(circle_at_70%_20%,#412D15_0%,#1F150C_38%,#121212_100%)] p-8">
        <div><span class="text-7xl font-semibold tracking-tighter text-accent-cream/80">{title.slice(0, 2).toUpperCase()}</span><p class="mt-3 text-sm uppercase tracking-[0.25em] text-accent-cream/60">{title}</p></div>
      </div>
    )}
  </div>
</article>
