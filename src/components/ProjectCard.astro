---
interface Props {
  title: string;
  description: string;
  tags: string[];
  source: string;
  story: string;
  image?: string;
  reverse?: boolean;
  index?: number;
}

const { title, description, tags, source, story, image, reverse = false, index = 0 } = Astro.props;
const softTagColors = ['#A6BFDD', '#D9A7B0', '#B9D8C2', '#E6C79C', '#C9B8E8'];
const tagColor = softTagColors[index % softTagColors.length];
---

<article
  class:list={[
    'group grid items-center gap-10 py-16 motion-safe:animate-[project-enter_900ms_cubic-bezier(0.22,1,0.36,1)_both] md:grid-cols-2 md:gap-16 lg:py-24',
    reverse && 'md:[&>div:first-child]:order-2 md:[&>div:last-child]:order-1',
  ]}
  style={`animation-delay: ${index * 100}ms; --project-tag-color: ${tagColor}`}
  >
  <div>
    <h3 class="max-w-xl text-4xl font-semibold tracking-tight text-white sm:text-5xl">{title}</h3>
    <p class="mt-6 max-w-lg text-lg leading-8 text-slate-300">{description}</p>
    <div class="mt-8 flex flex-wrap gap-2">
      {tags.map((tag) => <span class="project-tag px-3.5 py-1.5 text-xs font-semibold shadow-sm shadow-black/10">{tag}</span>)}
    </div>
  </div>

  <div class="relative">
    {image ? (
      <>
        <button type="button" class="project-preview relative z-10 block w-full cursor-pointer overflow-hidden rounded-[1.75rem] border border-white/25 bg-black/20 text-left transition-colors duration-500 hover:border-white/60" data-project-image={image} data-project-title={title} data-project-source={source} aria-label={`Ver imágenes de ${title}`}>
          <img src={image} alt={`Captura de ${title}`} class="block h-auto w-full" />
        </button>
      </>
    ) : (
      <div class="flex min-h-[280px] items-end bg-[radial-gradient(circle_at_70%_20%,#412D15_0%,#1F150C_38%,#121212_100%)] p-8">
        <div><span class="text-7xl font-semibold tracking-tighter text-accent-cream/80">{title.slice(0, 2).toUpperCase()}</span><p class="mt-3 text-sm uppercase tracking-[0.25em] text-accent-cream/60">{title}</p></div>
      </div>
    )}
  </div>
</article>
