    image: '/images/projects/Codeclub windowspc.png',
  },
  {
    title: 'Socios del Negocio',
    source: 'Matecore',
    description: 'Plataforma de marketing digital y cursos con landing pages de alta conversión, cupones, pagos con Stripe, CRM y experimentos A/B en Edge Middleware.',
    tags: ['Next.js', 'Stripe', 'GHL', 'GSAP'],
    image: '/images/projects/sociosnueva.png',
  },
  {
    title: 'TurnoCore',
    source: 'Matecore',
    description: 'SaaS multi-tenant de gestión de turnos con booking público, dashboard privado y marketplace de pagos con Mercado Pago.',
    tags: ['Next.js', 'Supabase', 'Prisma', 'Mercado Pago'],
    image: '/images/projects/turnocorenueva.png',
  },
  {
    title: 'JAM',
    source: 'Matecore',
