        <button id="project-modal-prev" type="button" class="absolute left-0 top-1/2 flex size-12 -translate-y-1/2 cursor-pointer items-center justify-center text-4xl text-white/80 transition-colors hover:text-white sm:-left-2" aria-label="Proyecto anterior">‹</button>
        <button id="project-modal-next" type="button" class="absolute right-0 top-1/2 flex size-12 -translate-y-1/2 cursor-pointer items-center justify-center text-4xl text-white/80 transition-colors hover:text-white sm:-right-2" aria-label="Proyecto siguiente">›</button>
      </div>
    </div>
  </dialog>

</BaseLayout>

<script>
  const modal = document.querySelector<HTMLDialogElement>('#project-modal');
  const modalImage = document.querySelector<HTMLImageElement>('#project-modal-image');
  const modalTitle = document.querySelector<HTMLElement>('#project-modal-title');
  const modalSource = document.querySelector<HTMLElement>('#project-modal-source');
  const previews = Array.from(document.querySelectorAll<HTMLButtonElement>('.project-preview'));
  let currentIndex = 0;
  let autoplay: number | undefined;

  const renderProject = (index: number) => {
    currentIndex = (index + previews.length) % previews.length;
    const preview = previews[currentIndex];
    if (!modalImage || !modalTitle || !modalSource) return;
    modalImage.src = preview.dataset.projectImage ?? '';
    modalImage.alt = preview.dataset.projectTitle ?? '';
    modalTitle.textContent = preview.dataset.projectTitle ?? '';
    modalSource.textContent = `· ${preview.dataset.projectSource ?? ''}`;
    modalImage.classList.remove('project-modal-enter');
    void modalImage.offsetWidth;
    modalImage.classList.add('project-modal-enter');
  };

  const stopAutoplay = () => {
    if (autoplay) window.clearInterval(autoplay);
    autoplay = undefined;
  };

  const startAutoplay = () => {
    stopAutoplay();
    if (window.matchMedia('(max-width: 639px)').matches && previews.length > 1) {
      autoplay = window.setInterval(() => renderProject(currentIndex + 1), 4500);
    }
  };

  previews.forEach((preview, index) => {
    preview.addEventListener('click', () => {
      renderProject(index);
      modal?.showModal();
      startAutoplay();
    });
  });

  document.querySelector('#project-modal-prev')?.addEventListener('click', () => renderProject(currentIndex - 1));
  document.querySelector('#project-modal-next')?.addEventListener('click', () => renderProject(currentIndex + 1));
  modal?.addEventListener('close', stopAutoplay);
  modal?.addEventListener('click', (event) => {
    if (event.target === modal) modal.close();
  });

  let dragStart = 0;
  modalImage?.addEventListener('pointerdown', (event) => {
    dragStart = event.clientX;
    modalImage.setPointerCapture(event.pointerId);
  });
  modalImage?.addEventListener('pointerup', (event) => {
    const distance = event.clientX - dragStart;
    if (Math.abs(distance) > 50) renderProject(currentIndex + (distance < 0 ? 1 : -1));
  });
</script>

<script>
  const featuredTrack = document.querySelector<HTMLElement>('[data-featured-track]');
  const featuredCarousel = document.querySelector<HTMLElement>('[data-featured-carousel]');
  const featuredSlides = featuredTrack ? [...featuredTrack.querySelectorAll<HTMLElement>(':scope > article')] : [];
  const featuredIndicator = document.querySelector<HTMLElement>('[data-featured-indicator]');
  let featuredIndex = 0;
  let featuredDragStart = 0;

  const renderFeatured = (index: number) => {
    if (!featuredTrack || !featuredSlides.length) return;
    featuredIndex = (index + featuredSlides.length) % featuredSlides.length;
    featuredTrack.style.transform = `translate3d(-${featuredSlides[featuredIndex].offsetLeft}px, 0, 0)`;
    if (featuredIndicator) featuredIndicator.textContent = `${String(featuredIndex + 1).padStart(2, '0')} / ${String(featuredSlides.length).padStart(2, '0')}`;
  };

  document.querySelector('[data-featured-prev]')?.addEventListener('click', () => renderFeatured(featuredIndex - 1));
  document.querySelector('[data-featured-next]')?.addEventListener('click', () => renderFeatured(featuredIndex + 1));
  featuredCarousel?.addEventListener('pointerdown', (event) => { featuredDragStart = event.clientX; });
  featuredCarousel?.addEventListener('pointerup', (event) => {
    const distance = event.clientX - featuredDragStart;
    if (Math.abs(distance) > 50) renderFeatured(featuredIndex + (distance < 0 ? 1 : -1));
  });
  window.addEventListener('resize', () => renderFeatured(featuredIndex));
  renderFeatured(0);
</script>

<script>
  const tetrisCanvas = document.querySelector<HTMLCanvasElement>('.tetris-canvas');
  const tetrisContext = tetrisCanvas?.getContext('2d');
  const bridgeCanvases = [...document.querySelectorAll<HTMLCanvasElement>('.tetris-bridge-canvas')];
  const bridgeContexts = bridgeCanvases.map((canvas) => canvas.getContext('2d'));
  const contactButton = document.querySelector<HTMLElement>('#contact-button');
  const boardWidth = 16;
  const boardHeight = 6;
  const cellWidth = 60;
  const rowHeight = 44;
  const fallSpeed = 2.4;
  const pieces = [
    { color: '#21D4C6', cells: [[0, 0], [1, 0], [2, 0], [3, 0]] },
    { color: '#C6E51B', cells: [[0, 0], [1, 0], [0, 1], [1, 1]] },
    { color: '#7B4DE8', cells: [[0, 0], [1, 0], [2, 0], [1, 1]] },
    { color: '#36D275', cells: [[1, 0], [2, 0], [0, 1], [1, 1]] },
    { color: '#F05268', cells: [[0, 0], [1, 0], [1, 1], [2, 1]] },
    { color: '#3E8EF7', cells: [[0, 0], [0, 1], [1, 1], [2, 1]] },
    { color: '#FF9D32', cells: [[2, 0], [0, 1], [1, 1], [2, 1]] },
  ];
  const board = Array.from({ length: boardHeight }, () => Array(boardWidth).fill(null));
  const bridgeRows: Array<Array<string | null>> = [];
  let activePiece = pieces[0];
  let activeX = 0;
  let activeY = 0;
  let pieceIndex = 0;
  let lastTime = 0;
  let bag: typeof pieces = [];
  let impactTime = 0;
  let impactCells: Array<[number, number]> = [];
  let bridgeOffset = 0;
  let lastLockedColor = '#F1EEE6';
  let boardPushCount = 0;
  let buttonCooldown = 0;
  let pendingButtonColor: string | null = null;
  let renderCellWidth = 50;
  let renderRowHeight = 44;
  let bridgeRenderRowHeight = 44;
  let renderOffsetX = 0;

  const resizeCanvases = () => {
    if (!tetrisCanvas || !tetrisContext) return;
    const dpr = window.devicePixelRatio || 1;
    const rect = tetrisCanvas.getBoundingClientRect();
    tetrisCanvas.width = Math.max(1, Math.floor(rect.width * dpr));
    tetrisCanvas.height = Math.max(1, Math.floor(rect.height * dpr));
    tetrisContext.setTransform(dpr, 0, 0, dpr, 0, 0);
    renderCellWidth = Math.min(50, rect.width / boardWidth);
    renderRowHeight = Math.min(44, rect.height / boardHeight);
    renderOffsetX = Math.max(0, (rect.width - renderCellWidth * boardWidth) / 2);
    bridgeCanvases.forEach((canvas, index) => {
      const context = bridgeContexts[index];
      if (!context) return;
      const bridgeRect = canvas.getBoundingClientRect();
      canvas.width = Math.max(1, Math.floor(bridgeRect.width * dpr));
      canvas.height = Math.max(1, Math.floor(bridgeRect.height * dpr));
      context.setTransform(dpr, 0, 0, dpr, 0, 0);
      bridgeRenderRowHeight = bridgeRect.height / 3;
    });
    drawTetris();
    drawBridge();
  };

  const updateButtonColor = (color: string) => {
    contactButton?.style.setProperty('--tetris-button-color', color);
    buttonCooldown = 1.8;
    pendingButtonColor = null;
  };

  const nextPiece = () => {
    if (!bag.length) bag = [...pieces].sort(() => Math.random() - 0.5);
    return bag.pop() ?? pieces[0];
  };

  const shade = (hex: string, amount: number) => {
    const value = Number.parseInt(hex.slice(1), 16);
    const r = Math.max(0, Math.min(255, (value >> 16) + amount));
    const g = Math.max(0, Math.min(255, ((value >> 8) & 255) + amount));
    const b = Math.max(0, Math.min(255, (value & 255) + amount));
    return `rgb(${r}, ${g}, ${b})`;
  };

  const collides = (x: number, y: number) => activePiece.cells.some(([dx, dy]) => {
    const boardX = x + dx;
    const boardY = Math.floor(y + dy);
    return boardX < 0 || boardX >= boardWidth || boardY >= boardHeight || (boardY >= 0 && board[boardY][boardX]);
  });

  const spawnPiece = () => {
    activePiece = nextPiece();
    pieceIndex += 1;
    const maxOffset = Math.max(...activePiece.cells.map(([dx]) => dx));
    activeX = Math.floor(Math.random() * (boardWidth - maxOffset));
    activeY = -1;
    if (collides(activeX, activeY)) {
      const pushedRow = board.pop();
      if (pushedRow) {
        bridgeRows.unshift(pushedRow);
        bridgeOffset = -bridgeRenderRowHeight;
        boardPushCount += 1;
        if (boardPushCount % 3 === 0) {
          pendingButtonColor = lastLockedColor;
          if (buttonCooldown <= 0) updateButtonColor(lastLockedColor);
        }
      }
      bridgeRows.splice(3);
      board.unshift(Array(boardWidth).fill(null));
    }
  };

  const lockPiece = () => {
    lastLockedColor = activePiece.color;
    activePiece.cells.forEach(([dx, dy]) => {
      const y = Math.floor(activeY + dy);
      if (y >= 0) {
        board[y][activeX + dx] = activePiece.color;
        impactCells.push([activeX + dx, y]);
      }
    });
    impactTime = 0.18;
    for (let y = boardHeight - 1; y >= 0; y -= 1) {
      if (board[y].every(Boolean)) {
        board.splice(y, 1);
        board.unshift(Array(boardWidth).fill(null));
        y += 1;
      }
    }
    spawnPiece();
  };

  const drawBlockOn = (context: CanvasRenderingContext2D, x: number, y: number, color: string, offsetY = 0, blockRowHeight = renderRowHeight) => {
    const px = renderOffsetX + x * renderCellWidth;
    const py = y * blockRowHeight + offsetY;
    context.fillStyle = color;
    context.fillRect(px, py, renderCellWidth, blockRowHeight);
  };

  const drawBlock = (x: number, y: number, color: string, offsetY = 0) => {
    if (!tetrisContext) return;
    drawBlockOn(tetrisContext, x, y, color, offsetY);
  };

  const drawTetris = () => {
    if (!tetrisContext || !tetrisCanvas) return;
    tetrisContext.clearRect(0, 0, tetrisCanvas.width, tetrisCanvas.height);
    board.forEach((row, y) => row.forEach((color, x) => {
      if (!color) return;
      const impacted = impactCells.some(([impactX, impactY]) => impactX === x && impactY === y);
      const bounce = impacted && impactTime > 0 ? -Math.sin((impactTime / 0.18) * Math.PI) * 3 : 0;
      drawBlock(x, y, color, bounce);
    }));
    activePiece.cells.forEach(([dx, dy]) => {
      if (activeY + dy >= 0) drawBlock(activeX + dx, activeY + dy, activePiece.color);
    });
  };

  const drawBridge = () => {
    bridgeContexts.forEach((context, index) => {
      const canvas = bridgeCanvases[index];
      if (!context || !canvas) return;
      context.clearRect(0, 0, canvas.width, canvas.height);
      bridgeRows.forEach((row, y) => row.forEach((color, x) => color && drawBlockOn(context, x, Math.max(0, 3 - bridgeRows.length + y), color, bridgeOffset, bridgeRenderRowHeight)));
    });
  };

  const tick = (time: number) => {
    const delta = lastTime ? Math.min((time - lastTime) / 1000, 0.05) : 0;
    lastTime = time;
    impactTime = Math.max(0, impactTime - delta);
    buttonCooldown = Math.max(0, buttonCooldown - delta);
    if (buttonCooldown === 0 && pendingButtonColor) updateButtonColor(pendingButtonColor);
    bridgeOffset += (0 - bridgeOffset) * Math.min(delta * 9, 1);
    const nextY = activeY + delta * fallSpeed;
    const landingY = Math.floor(activeY);
    if (nextY >= landingY && collides(activeX, landingY + 1)) {
      activeY = landingY;
      lockPiece();
    } else {
      activeY = nextY;
    }
    if (impactTime === 0) impactCells = [];
    drawBridge();
    drawTetris();
    window.requestAnimationFrame(tick);
  };

  if (tetrisCanvas && tetrisContext) {
    window.addEventListener('resize', resizeCanvases);
    resizeCanvases();
    spawnPiece();
    drawTetris();
    drawBridge();
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) window.requestAnimationFrame(tick);
  }

</script>
