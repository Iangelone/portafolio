---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';

const projects = [
  {
    title: 'CodeClubIDE',
    description: 'IDE offline-first construido desde cero: editor, terminal, debugger y tres modos —Coding, Studio y Design— con agentes de IA, memoria persistente y RAG local.',
    tags: ['Electron', 'React', 'Rust', 'WASM', 'IA'],
  },
  {
    title: 'TurnoCore',
    description: 'SaaS multi-tenant de gestión de turnos con booking público, dashboard privado y marketplace de pagos con Mercado Pago.',
    tags: ['Next.js', 'Supabase', 'Prisma', 'Mercado Pago'],
    image: '/images/projects/turnocore.png',
  },
  {
    title: 'Socios del Negocio',
    description: 'Plataforma de marketing digital y cursos con landing pages de alta conversión, pagos con Stripe, CRM y experimentos A/B en Edge Middleware.',
    tags: ['Next.js', 'Stripe', 'GHL', 'GSAP'],
    image: '/images/projects/socios-webinar.png',
  },
  {
    title: 'Bewell Esthetic Miami',
    description: 'Sitio premium bilingüe para una clínica estética, con booking online, captación automatizada de leads y una experiencia de marca animada.',
    tags: ['Next.js', 'i18n', 'Calendly', 'GoHighLevel'],
  },
  {
    title: 'Concierge',
    description: 'SaaS de asistencia comercial con IA que genera cotizaciones, gestiona clientes y coordina cuatro sub-agentes especializados en tiempo real.',
    tags: ['AI SDK', 'Supabase', 'RAG', 'DDD'],
    image: '/images/projects/concierge.png',
  },
  {
    title: 'UI Scanner Rust',
    description: 'Scanner de escritorio que combina UIAutomation, Win32 y GDI para convertir ventanas de Windows en HTML semántico y controlarlas con un agente IA.',
    tags: ['Rust', 'Win32', 'UIAutomation', 'OpenAI'],
  },
];

const stack = ['TypeScript', 'React', 'Next.js', 'Astro', 'Rust', 'Python', 'Electron', 'Tauri', 'PostgreSQL', 'Supabase', 'Prisma', 'OpenAI', 'WebAssembly', 'Vite+'];
---

<BaseLayout title="Ignacio Angelone · Senior Software Engineer (AI)" description="Senior Software Engineer (AI) especializado en productos web, desktop e inteligencia artificial.">
  <section id="inicio" class="relative flex min-h-[100svh] flex-col overflow-hidden border-b border-ink-500">
    <div class="flex flex-1 flex-col overflow-hidden bg-ink-900">
      <div class="relative h-[25svh] min-h-[180px] max-h-[280px] shrink-0 overflow-hidden bg-ink-800">
        <div class="absolute inset-0 scale-110 bg-cover bg-center" style="background-image: url('https://images.unsplash.com/photo-1772289495927-aa33999f8e1e?q=80&w=1332&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D');"></div>
        <div class="absolute inset-0 bg-ink-950/55"></div>
        <div class="absolute inset-0 bg-gradient-to-b from-transparent to-ink-900/90"></div>
      </div>
      <div class="relative mx-auto flex w-full flex-1 flex-col justify-center max-w-6xl px-6 pb-14 pt-32 sm:px-10 sm:pb-16 sm:pt-36">
        <img src="/images/profile.jpeg" alt="Ignacio Angelone" class="absolute -top-20 left-6 h-40 w-40 rounded-full border-8 border-ink-900 object-cover shadow-xl shadow-black/30 sm:left-10 sm:h-44 sm:w-44" />
        <div class="max-w-4xl">
          <p class="text-sm font-semibold uppercase tracking-[0.3em] text-accent-cream">Senior Software Engineer (AI)</p>
          <h1 class="mt-5 text-5xl font-bold tracking-tight sm:text-7xl lg:text-[5rem]">Hago que las ideas funcionen.</h1>
          <p class="mt-7 max-w-2xl text-lg leading-8 text-slate-400">Soy Ignacio Angelone, ingeniero de software senior especializado en IA. Diseño y construyo SaaS, herramientas de escritorio e interfaces inteligentes desde la arquitectura hasta producción.</p>
          <div class="mt-9 flex flex-wrap gap-4">
            <a href="#proyectos" class="rounded-full bg-accent-cream px-5 py-3 font-semibold text-accent-brown-dark transition hover:bg-white">Ver proyectos</a>
            <a href="#contacto" class="rounded-full border border-ink-400 px-5 py-3 font-semibold text-slate-200 transition hover:border-accent-cream">Contactarme</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="proyectos" class="mx-auto max-w-6xl scroll-mt-8 px-6 pb-24">
    <div class="mb-7 flex items-end justify-between gap-4"><h2 class="text-2xl font-semibold">Proyectos destacados</h2><span class="text-sm text-accent-cream">Trabajo seleccionado</span></div>
    <div class="grid gap-5 md:grid-cols-2">{projects.map((project) => <ProjectCard {...project} />)}</div>
  </section>

  <section id="sobre-mi" class="mx-auto max-w-6xl scroll-mt-8 px-6 pb-24">
    <div class="grid gap-12 lg:grid-cols-[0.7fr_1.3fr]">
      <div><p class="text-sm font-semibold uppercase tracking-[0.3em] text-accent-cream">Sobre mí</p><h2 class="mt-4 text-4xl font-bold tracking-tight">Del prototipo al producto.</h2></div>
      <div><p class="text-lg leading-8 text-slate-400">Empecé con Blueprints en Unreal Engine y evolucioné hacia productos SaaS multi-tenant, automatizaciones, integraciones de pago, bots de trading y herramientas de IA. Me interesa entender el problema completo y construir soluciones que realmente se puedan usar.</p><div class="mt-8 flex flex-wrap gap-2">{stack.map((item) => <span class="rounded-full border border-ink-500 bg-ink-900 px-3 py-1.5 text-sm text-slate-300">{item}</span>)}</div></div>
    </div>
  </section>

  <section id="experiencia" class="mx-auto max-w-6xl scroll-mt-8 px-6 pb-24">
    <p class="text-sm font-semibold uppercase tracking-[0.3em] text-accent-cream">Experiencia</p>
    <div class="mt-7 grid gap-5 md:grid-cols-2"><div class="rounded-2xl border border-ink-500 bg-ink-900 p-6"><p class="text-sm text-slate-500">oct. 2024 — actualidad · Remoto</p><h3 class="mt-3 text-xl font-semibold">Desarrollador de Software · Matecore</h3><p class="mt-3 leading-7 text-slate-400">SaaS multi-tenant, pagos, agentes de IA, automatizaciones CRM y testing E2E. Implementé soluciones que generaron más de $16K USD para un cliente.</p></div><div class="rounded-2xl border border-ink-500 bg-ink-900 p-6"><p class="text-sm text-slate-500">ago. 2023 — jul. 2024 · Remoto</p><h3 class="mt-3 text-xl font-semibold">Desarrollador Full-Stack Independiente</h3><p class="mt-3 leading-7 text-slate-400">Soluciones web full-stack con React y Next.js, desde requisitos y arquitectura hasta deploy, además de prototipos multijugador en Unreal Engine.</p></div></div>
  </section>

  <section id="contacto" class="mx-auto max-w-6xl scroll-mt-8 px-6 pb-28"><div class="rounded-3xl border border-accent-brown/70 bg-accent-brown-dark/80 p-8 sm:p-12"><p class="text-sm uppercase tracking-[0.3em] text-accent-cream">¿Trabajamos juntos?</p><h2 class="mt-4 text-4xl font-bold tracking-tight">Contame qué estás construyendo.</h2><a class="mt-7 inline-block font-semibold text-accent-cream hover:text-white" href="mailto:hola@ejemplo.com">hola@ejemplo.com →</a></div></section>
</BaseLayout>
