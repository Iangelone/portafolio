  { number: '02', title: 'IA aplicada', description: 'Agentes y automatizaciones para tu negocio.', image: 'https://plus.unsplash.com/premium_photo-1776986783995-4ee059f318c9?q=80&w=1170&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D' },
  { number: '03', title: 'Contratación', description: 'Sumá un desarrollador a tu equipo y llevemos ideas a producción.', image: 'https://unsplash.com/photos/Im7lZjxeLhg/download?force=true&w=1332' },
