      <div class="mb-5 flex flex-wrap items-baseline justify-center gap-2">
        <h2 id="project-modal-title" class="text-2xl font-semibold tracking-tight sm:text-3xl"></h2>
        <span id="project-modal-source" class="text-sm text-accent-cream sm:text-base"></span>
      </div>
      <div class="relative flex min-h-[55vh] items-center justify-center overflow-hidden bg-black/20">
