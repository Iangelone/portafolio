---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ServiceCard from '../components/ServiceCard.astro';

const projects = [
  {
    title: 'Concierge',
    source: 'Proyecto personal',
    description: 'SaaS de asistencia comercial con IA que genera cotizaciones, gestiona clientes y coordina cuatro sub-agentes especializados en tiempo real.',
    tags: ['AI SDK', 'Supabase', 'RAG', 'DDD'],
    image: '/images/projects/concierge.png',
  },
  {
    title: 'Socios del Negocio',
    source: 'Matecore',
    description: 'Plataforma de marketing digital y cursos con landing pages de alta conversión, pagos con Stripe, CRM y experimentos A/B en Edge Middleware.',
    tags: ['Next.js', 'Stripe', 'GHL', 'GSAP'],
    image: '/images/projects/socios-webinar.png',
  },
  {
    title: 'CodeClubIDE',
    source: 'Proyecto personal',
    description: 'IDE offline-first construido desde cero: editor, terminal, debugger y tres modos —Coding, Studio y Design— con agentes de IA, memoria persistente y RAG local.',
    tags: ['Electron', 'React', 'Rust', 'WASM', 'IA'],
    image: '/images/projects/Codeclub.png',
  },
  {
    title: 'TurnoCore',
    source: 'Matecore',
    description: 'SaaS multi-tenant de gestión de turnos con booking público, dashboard privado y marketplace de pagos con Mercado Pago.',
    tags: ['Next.js', 'Supabase', 'Prisma', 'Mercado Pago'],
    image: '/images/projects/turnocore.png',
  },
  {
    title: 'JAM',
    source: 'Matecore',
    description: 'Landing page promocional fullscreen con slider cinematográfico, autenticación y dashboard de competidor.',
    tags: ['Next.js', 'GSAP', 'Better Auth', 'PostgreSQL'],
    image: '/images/projects/JAM.png',
  },
  {
    title: 'Bewell Esthetic Miami',
    source: 'Matecore',
    description: 'Sitio premium bilingüe para una clínica estética, con booking online, captación automatizada de leads y una experiencia de marca animada.',
    tags: ['Next.js', 'i18n', 'Calendly', 'GoHighLevel'],
    image: '/images/projects/bewell.png',
  },
];

const stack = ['TypeScript', 'React', 'Next.js', 'Astro', 'Rust', 'Python', 'Electron', 'Tauri', 'PostgreSQL', 'Supabase', 'Prisma', 'OpenAI', 'WebAssembly', 'Vite+'];
const featuredProjects = projects.slice(0, 2);
const otherProjects = projects.slice(2);
const services = [
  { number: '01', title: 'Productos web', description: 'SaaS, dashboards y herramientas para operar mejor.', image: 'https://images.unsplash.com/photo-1577547664907-926044d3fc49?q=80&w=1170&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D' },
  { number: '02', title: 'IA aplicada', description: 'Agentes y automatizaciones para tu negocio.', image: 'https://plus.unsplash.com/premium_photo-1776986783995-4ee059f318c9?q=80&w=1170&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D' },
  { number: '03', title: 'Herramientas internas', description: 'Software a medida para trabajar mejor.', image: 'https://unsplash.com/photos/Im7lZjxeLhg/download?force=true&w=1332' },
];
---

<BaseLayout title="Ignacio Angelone · Software Developer" description="Software Developer especializado en productos web, desktop e inteligencia artificial.">
  <section id="inicio" class="relative flex min-h-[100svh] flex-col overflow-hidden border-b border-ink-500 bg-black">
    <div class="flex flex-1 flex-col overflow-hidden bg-black">
        <div class="relative h-[25svh] min-h-[180px] max-h-[280px] shrink-0 overflow-hidden border-b border-white/20 bg-black">
            <div class="isometric-stage" role="img" aria-label="Tetris animado">
            <canvas class="tetris-canvas" width="1200" height="280" role="img" aria-label="Tetris animado"></canvas>
          </div>
          <div class="absolute inset-0 bg-gradient-to-t from-black via-black/10 to-transparent"></div>
      </div>
      <div class="relative mx-auto flex w-full flex-1 flex-col justify-center bg-black max-w-6xl px-6 pb-14 pt-32 sm:px-10 sm:pb-16 sm:pt-36">
        <div class="absolute -top-20 left-6 z-10 h-40 w-40 rounded-full border-4 border-white/75 bg-black p-1 shadow-xl shadow-black/30 sm:left-10 sm:h-44 sm:w-44">
          <a href="https://www.linkedin.com/in/ignacioangelone/" target="_blank" rel="noreferrer" aria-label="Ver perfil de Ignacio Angelone en LinkedIn" class="group/avatar relative block h-full w-full overflow-hidden rounded-full bg-black">
            <img src="/images/profile.jpeg" alt="Ignacio Angelone" class="h-full w-full object-cover" />
            <span class="absolute inset-0 flex items-center justify-center bg-black/90 text-3xl font-bold text-white opacity-0 transition-opacity duration-300 group-hover/avatar:opacity-100 group-focus-visible/avatar:opacity-100">in</span>
          </a>
        </div>
        <div class="max-w-4xl">
          <p class="text-sm font-semibold uppercase tracking-[0.3em] text-accent-cream">Software Developer</p>
          <h1 class="kinetic-title mt-5 text-5xl font-bold tracking-tight sm:text-7xl lg:text-[5rem]" data-text="Hago que las ideas funcionen." aria-label="Hago que las ideas funcionen.">
            <span aria-hidden="true" class="kinetic-word">Hago</span>{' '}
            <span aria-hidden="true" class="kinetic-word">que</span>{' '}
            <span aria-hidden="true" class="kinetic-word">las</span>{' '}
            <span aria-hidden="true" class="kinetic-word">ideas</span>{' '}
            <span aria-hidden="true" class="kinetic-word">funcionen.</span>
          </h1>
          <p class="mt-7 max-w-2xl text-lg leading-8 text-slate-400">Soy Ignacio. Trabajo como Software Developer y me gusta llevar las ideas desde la primera conversación hasta un producto que se pueda usar.</p>
          <div class="mt-9 flex flex-wrap gap-4">
            <a href="#proyectos" class="rounded-full bg-accent-cream px-5 py-3 font-semibold text-accent-brown-dark transition-all duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] hover:-translate-y-0.5 hover:bg-white hover:shadow-[0_8px_22px_rgba(225,220,201,0.14)] active:scale-[0.98]">Ver proyectos</a>
            <a href="https://wa.me/5491122867368?text=Hola%20Ignacio%2C%20vengo%20de%20tu%20portafolio%20y%20me%20gustar%C3%ADa%20hablar%20sobre%20un%20proyecto." target="_blank" rel="noreferrer" class="rounded-full border border-ink-400 px-5 py-3 font-semibold text-slate-200 transition-all duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] hover:-translate-y-0.5 hover:border-accent-cream hover:bg-ink-800 hover:shadow-[0_8px_22px_rgba(225,220,201,0.08)] active:scale-[0.98]">Hablemos de tu idea</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="tetris-bridge" aria-hidden="true">
    <canvas class="tetris-bridge-canvas" width="1200" height="132"></canvas>
  </section>

  <section class="mx-auto max-w-6xl bg-black px-6 pb-8 pt-20 sm:pt-28">
    <div><p class="text-sm font-semibold uppercase tracking-[0.3em] text-accent-cream">En qué puedo ayudarte</p><h2 class="mt-4 max-w-2xl text-3xl font-semibold tracking-tight">Cuando una idea necesita convertirse en algo real.</h2></div>
    <div class="mt-10">{services.map((service) => <ServiceCard {...service} />)}</div>
  </section>

  <section id="proyectos" class="mx-auto max-w-6xl bg-black scroll-mt-8 px-6 pb-24 pt-20 sm:pt-28">
    <div class="mb-7 flex flex-col items-start gap-2 sm:flex-row sm:items-end sm:justify-between sm:gap-4"><h2 class="text-2xl font-semibold">Proyectos destacados</h2><span class="text-sm text-accent-cream">Trabajo seleccionado</span></div>
    <div>{featuredProjects.map((project, index) => <ProjectCard {...project} index={index} reverse={index % 2 === 1} />)}</div>
    <div class="mb-7 mt-16 flex flex-col items-start gap-2 border-t border-ink-500 pt-16 sm:mt-24 sm:flex-row sm:items-end sm:justify-between sm:gap-4"><h2 class="text-2xl font-semibold">Proyectos</h2><span class="text-sm text-accent-cream">Trabajo realizado</span></div>
    <div>{otherProjects.map((project, index) => <ProjectCard {...project} index={index + 2} reverse={(index + 2) % 2 === 1} />)}</div>
  </section>

  <section id="sobre-mi" class="mx-auto max-w-6xl bg-black scroll-mt-8 px-6 pb-24">
    <div class="grid gap-12 lg:grid-cols-[0.7fr_1.3fr]">
      <div><p class="text-sm font-semibold uppercase tracking-[0.3em] text-accent-cream">Sobre mí</p><h2 class="mt-4 text-4xl font-bold tracking-tight">Del prototipo al producto.</h2></div>
      <div><p class="text-lg leading-8 text-slate-400">Empecé con Blueprints en Unreal Engine y mi camino me llevó a desarrollar software, "back", "front", "AI" y un largo etc. Me interesa mucho construir soluciones que realmente mejoren la calidad de vida del usuario.</p><div class="mt-8 flex flex-wrap gap-2">{stack.map((item) => <span class="rounded-full border border-ink-500 bg-ink-900 px-3 py-1.5 text-sm text-slate-300">{item}</span>)}</div></div>
    </div>
  </section>

  <section id="experiencia" class="mx-auto max-w-6xl bg-black scroll-mt-8 px-6 pb-24">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.3em] text-accent-cream">Experiencia</p>
        <h2 class="mt-4 text-3xl font-semibold tracking-tight">Lo que fui construyendo.</h2>
      </div>
      <span class="text-sm text-accent-cream">Trabajo seleccionado</span>
    </div>
    <div class="mt-10 divide-y divide-white/15 border-y border-white/20">
      <article class="py-7 sm:py-9">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-baseline sm:justify-between sm:gap-8">
          <h3 class="text-2xl font-semibold tracking-tight text-white">Desarrollador de Software <span class="text-slate-500">·</span> Matecore</h3>
          <p class="shrink-0 text-sm leading-6 text-slate-400 sm:text-right">oct. 2024 — actualidad<br />Remoto</p>
        </div>
        <div>
          <p class="mt-3 max-w-2xl leading-7 text-slate-400">SaaS multi-tenant, pagos, agentes de IA, automatizaciones CRM y testing E2E. Implementé soluciones que generaron más de $16K USD para un cliente.</p>
        </div>
      </article>
      <article class="py-7 sm:py-9">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-baseline sm:justify-between sm:gap-8">
          <h3 class="text-2xl font-semibold tracking-tight text-white">Desarrollador Full-Stack Independiente</h3>
          <p class="shrink-0 text-sm leading-6 text-slate-400 sm:text-right">ago. 2023 — jul. 2024<br />Remoto</p>
        </div>
        <div>
          <p class="mt-3 max-w-2xl leading-7 text-slate-400">Soluciones web full-stack con React y Next.js, desde requisitos y arquitectura hasta deploy, además de prototipos multijugador en Unreal Engine.</p>
        </div>
      </article>
    </div>
  </section>

  <dialog id="project-modal" class="m-auto w-[min(94vw,1200px)] max-w-none border-0 bg-transparent p-0 text-white backdrop:bg-black/85 backdrop:backdrop-blur-sm">
    <div class="relative flex max-h-[92vh] flex-col">
      <div class="mb-5 flex flex-wrap items-baseline justify-center gap-2">
        <h2 id="project-modal-title" class="text-2xl font-semibold tracking-tight sm:text-3xl"></h2>
        <span id="project-modal-source" class="text-sm text-accent-cream sm:text-base"></span>
      </div>
      <div class="relative flex min-h-[55vh] items-center justify-center overflow-hidden bg-black/20">
        <img id="project-modal-image" src="" alt="" class="max-h-[72vh] w-full select-none object-contain" draggable="false" />
        <button id="project-modal-prev" type="button" class="absolute left-0 top-1/2 flex size-12 -translate-y-1/2 cursor-pointer items-center justify-center text-4xl text-white/80 transition-colors hover:text-white sm:-left-2" aria-label="Proyecto anterior">‹</button>
        <button id="project-modal-next" type="button" class="absolute right-0 top-1/2 flex size-12 -translate-y-1/2 cursor-pointer items-center justify-center text-4xl text-white/80 transition-colors hover:text-white sm:-right-2" aria-label="Proyecto siguiente">›</button>
      </div>
    </div>
  </dialog>

</BaseLayout>

<script>
  const modal = document.querySelector<HTMLDialogElement>('#project-modal');
  const modalImage = document.querySelector<HTMLImageElement>('#project-modal-image');
  const modalTitle = document.querySelector<HTMLElement>('#project-modal-title');
  const modalSource = document.querySelector<HTMLElement>('#project-modal-source');
  const previews = Array.from(document.querySelectorAll<HTMLButtonElement>('.project-preview'));
  let currentIndex = 0;
  let autoplay: number | undefined;

  const renderProject = (index: number) => {
    currentIndex = (index + previews.length) % previews.length;
    const preview = previews[currentIndex];
    if (!modalImage || !modalTitle || !modalSource) return;
    modalImage.src = preview.dataset.projectImage ?? '';
    modalImage.alt = preview.dataset.projectTitle ?? '';
    modalTitle.textContent = preview.dataset.projectTitle ?? '';
    modalSource.textContent = `· ${preview.dataset.projectSource ?? ''}`;
    modalImage.classList.remove('project-modal-enter');
    void modalImage.offsetWidth;
    modalImage.classList.add('project-modal-enter');
  };

  const stopAutoplay = () => {
    if (autoplay) window.clearInterval(autoplay);
    autoplay = undefined;
  };

  const startAutoplay = () => {
    stopAutoplay();
    if (window.matchMedia('(max-width: 639px)').matches && previews.length > 1) {
      autoplay = window.setInterval(() => renderProject(currentIndex + 1), 4500);
    }
  };

  previews.forEach((preview, index) => {
    preview.addEventListener('click', () => {
      renderProject(index);
      modal?.showModal();
      startAutoplay();
    });
  });

  document.querySelector('#project-modal-prev')?.addEventListener('click', () => renderProject(currentIndex - 1));
  document.querySelector('#project-modal-next')?.addEventListener('click', () => renderProject(currentIndex + 1));
  modal?.addEventListener('close', stopAutoplay);
  modal?.addEventListener('click', (event) => {
    if (event.target === modal) modal.close();
  });

  let dragStart = 0;
  modalImage?.addEventListener('pointerdown', (event) => {
    dragStart = event.clientX;
    modalImage.setPointerCapture(event.pointerId);
  });
  modalImage?.addEventListener('pointerup', (event) => {
    const distance = event.clientX - dragStart;
    if (Math.abs(distance) > 50) renderProject(currentIndex + (distance < 0 ? 1 : -1));
  });
</script>

<script>
  const tetrisCanvas = document.querySelector<HTMLCanvasElement>('.tetris-canvas');
  const tetrisContext = tetrisCanvas?.getContext('2d');
  const bridgeCanvas = document.querySelector<HTMLCanvasElement>('.tetris-bridge-canvas');
  const bridgeContext = bridgeCanvas?.getContext('2d');
  const boardWidth = 24;
  const boardHeight = 6;
  const cellWidth = 50;
  const rowHeight = 44;
  const fallSpeed = 2.4;
  const pieces = [
    { color: '#21D4C6', cells: [[0, 0], [1, 0], [2, 0], [3, 0]] },
    { color: '#C6E51B', cells: [[0, 0], [1, 0], [0, 1], [1, 1]] },
    { color: '#7B4DE8', cells: [[0, 0], [1, 0], [2, 0], [1, 1]] },
    { color: '#36D275', cells: [[1, 0], [2, 0], [0, 1], [1, 1]] },
    { color: '#F05268', cells: [[0, 0], [1, 0], [1, 1], [2, 1]] },
    { color: '#3E8EF7', cells: [[0, 0], [0, 1], [1, 1], [2, 1]] },
    { color: '#FF9D32', cells: [[2, 0], [0, 1], [1, 1], [2, 1]] },
  ];
  const board = Array.from({ length: boardHeight }, () => Array(boardWidth).fill(null));
  const bridgeRows: Array<Array<string | null>> = [];
  let activePiece = pieces[0];
  let activeX = 0;
  let activeY = 0;
  let pieceIndex = 0;
  let lastTime = 0;
  let bag: typeof pieces = [];
  let impactTime = 0;
  let impactCells: Array<[number, number]> = [];
  let bridgeOffset = 0;

  const nextPiece = () => {
    if (!bag.length) bag = [...pieces].sort(() => Math.random() - 0.5);
    return bag.pop() ?? pieces[0];
  };

  const shade = (hex: string, amount: number) => {
    const value = Number.parseInt(hex.slice(1), 16);
    const r = Math.max(0, Math.min(255, (value >> 16) + amount));
    const g = Math.max(0, Math.min(255, ((value >> 8) & 255) + amount));
    const b = Math.max(0, Math.min(255, (value & 255) + amount));
    return `rgb(${r}, ${g}, ${b})`;
  };

  const collides = (x: number, y: number) => activePiece.cells.some(([dx, dy]) => {
    const boardX = x + dx;
    const boardY = Math.floor(y + dy);
    return boardX < 0 || boardX >= boardWidth || boardY >= boardHeight || (boardY >= 0 && board[boardY][boardX]);
  });

  const spawnPiece = () => {
    activePiece = nextPiece();
    pieceIndex += 1;
    const maxOffset = Math.max(...activePiece.cells.map(([dx]) => dx));
    activeX = Math.floor(Math.random() * (boardWidth - maxOffset));
    activeY = -1;
    if (collides(activeX, activeY)) {
      const pushedRow = board.pop();
      if (pushedRow) {
        bridgeRows.unshift(pushedRow);
        bridgeOffset = -rowHeight;
      }
      bridgeRows.splice(3);
      board.unshift(Array(boardWidth).fill(null));
    }
  };

  const lockPiece = () => {
    activePiece.cells.forEach(([dx, dy]) => {
      const y = Math.floor(activeY + dy);
      if (y >= 0) {
        board[y][activeX + dx] = activePiece.color;
        impactCells.push([activeX + dx, y]);
      }
    });
    impactTime = 0.18;
    for (let y = boardHeight - 1; y >= 0; y -= 1) {
      if (board[y].every(Boolean)) {
        board.splice(y, 1);
        board.unshift(Array(boardWidth).fill(null));
        y += 1;
      }
    }
    spawnPiece();
  };

  const drawBlockOn = (context: CanvasRenderingContext2D, x: number, y: number, color: string, offsetY = 0) => {
    const px = x * cellWidth;
    const py = y * rowHeight + offsetY;
    context.fillStyle = color;
    context.fillRect(px, py, cellWidth, rowHeight);
  };

  const drawBlock = (x: number, y: number, color: string, offsetY = 0) => {
    if (!tetrisContext) return;
    drawBlockOn(tetrisContext, x, y, color, offsetY);
  };

  const drawTetris = () => {
    if (!tetrisContext || !tetrisCanvas) return;
    tetrisContext.clearRect(0, 0, tetrisCanvas.width, tetrisCanvas.height);
    board.forEach((row, y) => row.forEach((color, x) => {
      if (!color) return;
      const impacted = impactCells.some(([impactX, impactY]) => impactX === x && impactY === y);
      const bounce = impacted && impactTime > 0 ? -Math.sin((impactTime / 0.18) * Math.PI) * 3 : 0;
      drawBlock(x, y, color, bounce);
    }));
    activePiece.cells.forEach(([dx, dy]) => {
      if (activeY + dy >= 0) drawBlock(activeX + dx, activeY + dy, activePiece.color);
    });
  };

  const drawBridge = () => {
    if (!bridgeContext || !bridgeCanvas) return;
    bridgeContext.clearRect(0, 0, bridgeCanvas.width, bridgeCanvas.height);
    bridgeRows.forEach((row, y) => row.forEach((color, x) => color && drawBlockOn(bridgeContext, x, y, color, bridgeOffset)));
  };

  const tick = (time: number) => {
    const delta = lastTime ? Math.min((time - lastTime) / 1000, 0.05) : 0;
    lastTime = time;
    impactTime = Math.max(0, impactTime - delta);
    bridgeOffset += (0 - bridgeOffset) * Math.min(delta * 9, 1);
    const nextY = activeY + delta * fallSpeed;
    const landingY = Math.floor(activeY);
    if (nextY >= landingY && collides(activeX, landingY + 1)) {
      activeY = landingY;
      lockPiece();
    } else {
      activeY = nextY;
    }
    if (impactTime === 0) impactCells = [];
    drawBridge();
    drawTetris();
    window.requestAnimationFrame(tick);
  };

  if (tetrisCanvas && tetrisContext) {
    spawnPiece();
    drawTetris();
    drawBridge();
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) window.requestAnimationFrame(tick);
  }
</script>
